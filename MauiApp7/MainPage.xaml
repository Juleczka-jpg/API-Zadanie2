<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp7.MainPage">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="Kursy walut NBP" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold"/>

        <Button x:Name="GetRatesBtn"
            Text="Pobierz kursy USD i EUR"
            Clicked="OnGetRatesClicked"
            HorizontalOptions="Center" />

        <Label x:Name="ResultLabel"
           FontSize="18"
           HorizontalOptions="Center"
           HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
    
</ContentPage>
